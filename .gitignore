__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.venv/
venv/

# scan output
*.tif
*.tiff
# Contact sheets, comparison sheets and heatmaps. Everything this project
# renders for a person to look at is a PNG, they are megabytes each, and they
# are all rebuildable from the stored raw bytes -- so none of them belong in
# history. Nothing here has ever needed a committed image; the two the docs
# mention are written to previews/, ignored below.
*.png
# the JSON sidecar tools/scan.py writes beside a bare `--out scan.tif`
# default (out.with_suffix(".json")) -- everything under scans/ is already
# covered above; this is only the no-flag, throwaway-CLI-run case.
scan.json

# USB captures - these record traffic from every device on the bus,
# including keyboard HID reports (i.e. keystrokes). Keep them local.
*.pcapng
*.pcap

.DS_Store

# working data, kept locally
scans/
previews/
captures/
calibration/
library/
# a second library unpacked beside the first, and the archive it came from
library 2/
*.rar

# per-roll scan output
rolls/

# registration walks: metered 300 dpi passes, their inverted copies and the
# contact sheets built from them. Both kinds are already covered above; these
# directories are named so the whole walk goes, not just its files.
rollscan/
walk7/
probe/

# local Claude config: machine-specific paths and permissions
.claude/*
# ...except skills, which are project knowledge and belong to everyone working
# here. They were lost once: added on a branch that never reached main, then
# removed by a clean because the blanket rule above made them invisible to git.
!.claude/skills/

# Where `make run-demo` writes, so trying the window out leaves no trace.
demo/

# What the scanning window remembers between launches -- per machine.
gui-settings.json
